# ThreatBrain configuration. Copy to `.env` (repo root, used by docker compose)
# and to `backend/.env` for running the API directly. NEVER commit real values.

# --- Application ------------------------------------------------------------
APP_NAME=ThreatBrain
# development | staging | production. production refuses to start with
# APP_DEBUG=true, CORS_ORIGINS=*, or a short SUPABASE_JWT_SECRET.
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=console            # json in production
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Set true ONLY behind a proxy that overwrites X-Forwarded-For (rate limits key on client IP)
TRUST_PROXY_HEADERS=false
ALLOW_PUBLIC_SIGNUP=true      # false = admins provision accounts
SEED_DEMO_DATA=true           # tagged sample threats/incidents in new workspaces; false for real use

# --- Supabase (https://supabase.com -> Project Settings -> API) --------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here   # server only, never ship to the browser
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here               # legacy HS256 JWT secret

# Frontend (baked into the static build)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- LLM (https://console.groq.com) -------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile    # per-agent models are set in the `agents` table
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=4

# --- Threat intelligence (all optional; each configured feed is queried) ------
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
OTX_API_KEY=

# --- Notifications (optional) -------------------------------------------------
# Only https://discord.com/api/webhooks/... URLs are accepted
DISCORD_WEBHOOK_URL=

# --- Pipeline tuning ----------------------------------------------------------
PIPELINE_STAGE_TIMEOUT_SECONDS=120
PIPELINE_WORKERS=4
DEDUP_WINDOW_MINUTES=30        # 0 disables alert de-duplication
CORRELATION_WINDOW_HOURS=72
INGEST_MAX_BATCH=50
HUNT_INTERVAL_MINUTES=0        # >0 runs the Hunt agent for every active org on this interval

# --- Rate limiting (per client IP) --------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
LLM_RATE_LIMIT_PER_MINUTE=20

# --- Platform (added in the enterprise phase) --------------------------------
# Queue / workers. EMBEDDED_WORKER=true runs a worker thread inside the API process (single-container mode).
# With docker-compose.prod.yml the workers are separate (`python -m app.worker`) and this is false.
EMBEDDED_WORKER=true
WORKER_CONCURRENCY=4
WORKER_POLL_SECONDS=1.0
JOB_LEASE_SECONDS=300          # a job not finished/extended within this is reclaimed by another worker
JOB_MAX_ATTEMPTS=5             # then dead-lettered (Operations -> requeue)
QUEUE_MAX_DEPTH=5000           # ingest answers 503 + Retry-After above these ceilings (backpressure)
QUEUE_MAX_DEPTH_PER_ORG=2000
# What the agent pipeline (LLM) runs on for ingested events: matched = only events a rule/correlation flagged
# (cost-controlled, recommended), all = everything, none = detection only.
INGEST_TRIAGE_MODE=matched

# Data retention (days). audit_logs are append-only and never purged.
RETENTION_EVENTS_DAYS=30       # events not linked to any threat
RETENTION_EVIDENCE_DAYS=365    # events kept as threat evidence
RETENTION_JOBS_DAYS=14
RETENTION_RUNS_DAYS=90
RETENTION_ANOMALIES_DAYS=90    # behavioural anomaly records
RETENTION_BASELINE_DAYS=180    # behavioural baselines of entities not seen for this long

# Security
APP_SECRET=                    # >= 32 random chars; enables HMAC-signed, replay-protected API keys. Keep in your secret manager.
METRICS_TOKEN=                 # bearer token for GET /metrics (Prometheus). Empty = endpoint disabled.
MAX_TOKEN_AGE_MINUTES=0        # >0 rejects user JWTs older than this even if not yet expired
# Asymmetric Supabase signing keys are verified via JWKS (default <SUPABASE_URL>/auth/v1/.well-known/jwks.json)
SUPABASE_JWKS_URL=
# Optional external OIDC IdP (users must already be provisioned; matched by verified email). https required.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALLOWED_ALGS=RS256,ES256

# LLM provider: groq | openai_compatible | none (none = detection/correlation only, no agents)
LLM_PROVIDER=groq
LLM_BASE_URL=                  # openai_compatible only (vLLM, Ollama, LiteLLM, ...); https:// required
LLM_API_KEY=
LLM_MODEL_OVERRIDE=            # one model name for every agent (required for non-Groq providers)
LLM_ALLOW_INSECURE_HTTP=false

# Onboarding: admins may load a synthetic demo campaign. Set false for production.
ALLOW_DEMO_LOAD=true

# Migrations (database/migrate.sh) use the DIRECT Postgres connection string, not the pooled/REST one
DATABASE_URL=
