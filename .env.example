# ThreatBrain configuration. Copy to `.env` (repo root, used by docker compose)
# and to `backend/.env` for running the API directly. NEVER commit real values.

# --- Application ------------------------------------------------------------
APP_NAME=ThreatBrain
# development | staging | production. production refuses to start with
# APP_DEBUG=true, CORS_ORIGINS=*, or a short SUPABASE_JWT_SECRET.
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=console            # json in production
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Set true ONLY behind a proxy that overwrites X-Forwarded-For (rate limits key on client IP)
TRUST_PROXY_HEADERS=false
ALLOW_PUBLIC_SIGNUP=true      # false = admins provision accounts
SEED_DEMO_DATA=true           # tagged sample threats/incidents in new workspaces; false for real use

# --- Supabase (https://supabase.com -> Project Settings -> API) --------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here   # server only, never ship to the browser
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here               # legacy HS256 JWT secret

# Frontend (baked into the static build)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- LLM (https://console.groq.com) -------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile    # per-agent models are set in the `agents` table
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=4

# --- Threat intelligence (all optional; each configured feed is queried) ------
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
OTX_API_KEY=

# --- Notifications (optional) -------------------------------------------------
# Only https://discord.com/api/webhooks/... URLs are accepted
DISCORD_WEBHOOK_URL=

# --- Pipeline tuning ----------------------------------------------------------
PIPELINE_STAGE_TIMEOUT_SECONDS=120
PIPELINE_WORKERS=4
DEDUP_WINDOW_MINUTES=30        # 0 disables alert de-duplication
CORRELATION_WINDOW_HOURS=72
INGEST_MAX_BATCH=50
HUNT_INTERVAL_MINUTES=0        # >0 runs the Hunt agent for every active org on this interval

# --- Rate limiting (per client IP) --------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
LLM_RATE_LIMIT_PER_MINUTE=20
