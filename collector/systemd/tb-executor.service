[Unit]
Description=ThreatBrain response executor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/tb-collector
ExecStart=/opt/tb-collector/venv/bin/python -m tb_executor --config /opt/tb-collector/executor.yaml
Restart=always
RestartSec=5
# Needs root to run iptables/usermod. Everything else is locked down; ProtectSystem
# is left off because usermod -L must write /etc/shadow.
User=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
